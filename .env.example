# ==============================================================================
# Campus Hub / CampusOne — Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# 1. Do NOT put production secrets or service role keys in this file.
# 2. In Vite, only variables prefixed with VITE_ are exposed to client code.
# ==============================================================================

# Supabase Project Credentials (Optional - Mock fallback active by default)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Application Mode
VITE_APP_ENV=development
VITE_APP_NAME="CampusOne"
